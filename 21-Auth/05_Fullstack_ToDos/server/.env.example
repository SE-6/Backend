# Copy this file to ".env" and fill in your own values.

MONGO_URI=your-mongodb-connection-string
NODE_ENV=development

# OpenAI (needed for the AI cover images)
OPENAI_API_KEY=your-openai-key

## JWT
ACCESS_JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=600 ## 10 minutes
JWT_ISSUER=SE006

REFRESH_JWT_SECRET=change-me-to-another-long-random-string
REFRESH_TOKEN_TTL=604800 ## 7 days

### Cloudinary (needed for image upload + storing the AI images)
CLOUD_NAME=your-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret
